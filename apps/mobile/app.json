{
  "expo": {
    "name": "Toushir Gros",
    "slug": "toushir-gros",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "toushirgros",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toushir.gros"
    },
    "android": {
      "package": "com.toushir.gros",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#002d2c"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Toushir Gros",
      "shortName": "Toushir",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#F6F7F7"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
